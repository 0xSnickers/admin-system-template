NODE_ENV=development
PORT=9000
DATABASE_URL="postgresql://app:password@localhost:5432/monitor_server?schema=public"
# 允许跨域的前端地址，逗号分隔；走同源代理时可留空
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
# 生产环境必须改成 32 位以上随机串：openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
COOKIE_SECURE=false
# 启动时创建演示账号 demo@example.com / password123（admin），生产环境关闭
SEED_DEMO_USER=true
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ---------- 监控 ----------
# 本服务在「后端日志」里显示的服务名
SERVICE_NAME=monitor-server
# 部署在 Nginx / 网关后面时设为 true，从 X-Forwarded-For 读取真实 IP（直接暴露公网时保持 false，否则 IP 可被伪造）
TRUST_PROXY=false
# 把本服务自己的请求日志 / 异常写入数据库（后台「后端日志」页面可查）
SELF_LOG_ENABLED=true
# 上报接口每个 IP 每分钟最多请求次数，超出返回 429 RATE_LIMITED
INGEST_RATE_LIMIT=600
# 监控数据保留天数，每小时清理一次过期数据
DATA_RETENTION_DAYS=30
# 启动时创建演示项目「Demo Web」（appKey: pk_demo_web）并生成 7 天模拟数据，生产环境关闭
SEED_DEMO_DATA=true
